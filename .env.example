# Vertex AI only — authentication uses locally stored ADC.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Kore
TTS_STYLE=Clear natural Korean documentary narration, consistent calm delivery
VERTEX_AI_VIDEO_MODEL=gemini-omni-1.1-flash-preview
# FLOWMAKER_HOME defaults to ~/.flowmaker, outside the repository.

# photoreal = all live-action; mixed = original clay/real composition
VIDEO_STYLE=photoreal
